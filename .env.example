# MySQL on Hostinger. URL-encode special characters in the password (@ becomes %40).
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin area (/admin). Required, otherwise admin is disabled. Use a long random string (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Admin users live in the database: create the first one with `npm run create-admin`.
ADMIN_SESSION_SECRET=

# Folder for uploaded photos (outside public/). Default: <project>/uploads. Use an absolute path that survives redeploys.
UPLOAD_DIR=
